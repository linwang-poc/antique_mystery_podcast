# .dockerignore - Exclude files from Docker build context

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Virtual environments
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Git
.git/
.gitignore
.gitattributes

# Documentation (not needed in container)
*.md
docs/

# Notebooks
*.ipynb
*.ipynb_checkpoints
notebooks/

# Logs
logs/
*.log

# Output files (mounted as volume)
output/

# Models (mounted as volume, not baked into image)
models/

# Testing
tests/
test_*.py
*_test.py
.pytest_cache/

# CI/CD
.github/
.gitlab-ci.yml

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Development scripts
RUN_*.sh
setup_*.sh

# Temporary files
*.tmp
*.temp
.env
.env.local
