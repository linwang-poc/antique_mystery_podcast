# Antique Mystery Podcast - Environment Variables
# Copy this file to .env and fill in your API keys if using LLM preprocessing

# Optional: LLM API Keys (for text preprocessing only)
# Uncomment the provider you want to use

# Anthropic Claude API
# ANTHROPIC_API_KEY=your_claude_api_key_here

# OpenAI API
# OPENAI_API_KEY=your_openai_api_key_here

# Application Settings
# APP_PORT=7860
# APP_HOST=127.0.0.1
